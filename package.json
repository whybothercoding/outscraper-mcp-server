{
  "name": "outscraper-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Model Context Protocol (MCP) server for Outscraper API (auto-generated from OpenAPI spec).",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "outscraper-mcp": "dist/index.js"
  },
  "scripts": {
    "prebuild": "node scripts/embed-openapi.mjs",
    "build": "tsc -p tsconfig.json",
    "dev": "node --enable-source-maps --watch dist/index.js",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "node scripts/embed-openapi.mjs && tsc -p tsconfig.json --noEmit",
    "tools:list": "node --enable-source-maps dist/toolsList.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "undici": "^6.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
